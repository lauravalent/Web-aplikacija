@model Accomodation

@{
	ViewData["Title"] = "Dodavanje novog smještaja";
}

<nav class="breadcrumb">
	<ol class="breadcrumb-dio">
		<li><a asp-action="Index">Popis smještaja</a></li>
		<li class="active" aria-current="page">Uređivanje smještaja</li>
	</ol>
</nav>

<section class="contact">
	<div class="contact-dio">
		<div class="contact-form">
			<form asp-controller="Accomodation" asp-action="Edit" method="post">
				<partial name="_CreateEdit" />
			</form>
		</div>
	</div>
</section>
