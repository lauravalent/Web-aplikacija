@model AccomodationFilterModel

<div class="filter-form">
    <form asp-action="Index" method="get">
        <label asp-for="StartDate">Od datuma: </label>
        <input asp-for="StartDate" type="date" min="@DateTime.Now.ToString("yyyy-MM-dd")" />
        <span asp-validation-for="StartDate" class="text-danger"></span>

        <label asp-for="EndDate">Do datuma: </label>
        <input asp-for="EndDate" type="date" min="@DateTime.Now.ToString("yyyy-MM-dd")" />
        <span asp-validation-for="EndDate" class="text-danger"></span>

        <label asp-for="Capacity">Broj osoba: </label>
        <input asp-for="Capacity" type="number" min="1" max="20" />

        <button type="submit">Pretraži</button>
    </form>
</div>

<script>
    document.getElementById('startDate').addEventListener('change', function () {
        document.getElementById('endDate').min = this.value;
    });
</script>