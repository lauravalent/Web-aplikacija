@model Rad.Model.Contact

<section class="contact">
    <div class="contact-dio">
        <div class="contact-info">
            <h1>Ovdje smo, kontaktirajte nas!</h1>
            <p>
                Naša Vas je priča zainteresirala, ali imate pitanja u vezi nas i naše vizije?
                Slobodno nam se javite putem forme desno ili naših kontakata napisanih ispod i rado ćemo Vam povratno odgovoriti!
                Slobodno pitajte što god Vas zanima u vezi smještaja ili naše ponude!
            </p>

            <p class="contact-details">
                <a href="https://www.facebook.com/ohoho.festival/?locale=hr_HR" target="_blank" rel="noopener noreferrer">
                    <i class="fa-brands fa-facebook"></i> Farmica Seoski Turizam<br>
                </a>
                <a href="mailto:cepelovecki@gmail.com" target="_blank" rel="noopener noreferrer">
                    <i class="fa-solid fa-envelope"></i>info@farmica.hr<br>
                </a>
                <a href="https://www.instagram.com/ohohofestival/" target="_blank" rel="noopener noreferrer">
                    <i class="fa-brands fa-instagram"></i> farmicaseoskiturizam<br>
                </a>
                <a href="#karta" class="karta-poveznica"><i class="fa-solid fa-location-dot lokacija"></i> Farmica Seoski Turizam,<br> Čepelovečki breg, 216</a>
            </p>
        </div>
        <div class="contact-form">
            <form asp-controller="Contact" asp-action="send" method="post">
                <label asp-for="Name">Ime i prezime*</label>
                <input asp-for="Name" type="text" placeholder="Tvoje ime i prezime" required>
                <span asp-validation-for="Name" class="text-danger"></span>

                <label asp-for="Email">Email*</label>
                <input asp-for="Email" type="email" placeholder="Tvoj e-mail" required>
                <span asp-validation-for="Email" class="text-danger"></span>

                <label asp-for="Message">Poruka*</label>
                <textarea asp-for="Message" placeholder="Tvoja poruka" rows="5" required></textarea>
                <span asp-validation-for="Message" class="text-danger"></span>

                <button type="submit">Pošalji</button>
            </form>
        </div>
    </div>
    <div class="details-dio">
        <div class="maps" id="karta">
            <iframe style="filter: invert(90%)" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d31311.26429434522!2d17.00460830555691!3d46.00209336043302!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4767cd507911ab39%3A0xfad52af602a3cd63!2zxIxlcGVsb3ZlxI1raSBicmVnIDIxNiwgNDgzNTAsIMSMZXBlbG92YWM!5e0!3m2!1shr!2shr!4v1778839669240!5m2!1shr!2shr" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
    </div>
    </div>
</section>