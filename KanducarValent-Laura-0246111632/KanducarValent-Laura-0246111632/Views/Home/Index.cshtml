
@{
    ViewData["Title"] = "Naslovna stranica";
}

<div class="hero">
    <picture class="hero-image">
        <source media="(max-width: 500px)"
                srcset="~/images/pixel_home1.webp">
        <source media="(min-width: 501px)"
                srcset="~/images/pixel_home1.webp">

        <img src="~/images/pixel_home1.webp" alt="OHOHO festival">
    </picture>
    <div class="hero-text-ohoho">
        <h1 class="animate-hero animate-left">Farmica<br>seoski turizam</h1>
        <h2 class="animate-date animate-left">na obroncima</h2>
        <a class="link-button-action" asp-area="" asp-controller="Accomodation" asp-action="Index">Istraži i rezerviraj!</a>
    </div>

</div>



<section class="uvod" id="section-istrazi">
    <div class="uvod-dio">
        <p class="uvod-paragraph animate-right">
            Seoski turizam Farmica smješten je na obroncima Bilogore gdje će Vas dočekati priroda i 
            mir kao savršen bijeg iz vreve grada. Šuma koja okružuje i koja je dio <span class="kljucno">Farmice</span> poznata
            je po svojoj bioraznolikosti, stoga budite spremni vidjeti i upoznati razne vrste biljaka 
            i životinja koje su svakodnevni gosti Farmice. Osim divljih životinja koje se skrivaju od 
            ljudskih pogleda, na Farmici ćete upoznati i naše domaće stanare koje uvijek oduševe i 
            razvesele sve naše goste svojom razigranošću.
        </p>
    </div>
</section>

<div class="arhiva-slika">
    <img src="/images/priroda1.jpeg" alt="ljudi">
    <img src="/images/priroda2.jpeg" alt="ljudi">
    <img src="/images/priroda3.jpeg" alt="ljudi">
</div>

<section class="uvod" id="section-istrazi">
    <div class="uvod-dio">
        <p class="uvod-paragraph animate-right">
            Odaberite vinogradarsku kućicu na Farmici kao privremeni dom dok uživate u svemu što Podravina nudi, od hrane, umjetnosti sve 
            do prirodnih ljepota i fenomena kao što su Đurđevački Peski. <span class="kljucno">Otkrijte</span> sve što Vam može ispuniti dane provedene 
            na našim prostorima i spoznajte zašto smo upravo ovaj dio Hrvatke odabrali za izgradnju naše male bajke.
        </p>
    </div>
</section>
<br id="section-voli">
<section class="quote">
    <div class="quote-dio">
        <p class="animate-up">
            "Naša vizija je da gostima pružimo idealni odmor u prirodi, a koji će odmoriti njihov um i tijelo. 
             Bavimo se ovim poslom jer volimo upoznavati nove ljude i kulture, a u isto vrijeme približiti našu kulturu i način 
             života našim gostima. Cilj su nam zadovoljni i namsijani gosti" ~ <span class="kljucno">tim Farmica</span>
        </p>
    </div>
</section>

<br id="section-upoznaj">
<section class="upoznaj">
    <div class="upoznaj-dio">
        <div class="maps" id="karta">
            <iframe style="filter: invert(90%)" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d31311.26429434522!2d17.00460830555691!3d46.00209336043302!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4767cd507911ab39%3A0xfad52af602a3cd63!2zxIxlcGVsb3ZlxI1raSBicmVnIDIxNiwgNDgzNTAsIMSMZXBlbG92YWM!5e0!3m2!1shr!2shr!4v1778839669240!5m2!1shr!2shr" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
        <div class="upoznaj-text animate-right">
            <p>
               Nalazimo se na 4 kilometra od grada Đurđevca, ljudima bolje poznat i kao grad Picoka, a do kojeg autom treba 10 minuta. 
               Znat ćete da ste na dobrom putu kada oko Vas počinje biti sve više i više zelenila jer se Farmica nalazi na brijegu prepunom vinogradima i šumama.
               Cesta do Farmice je asfaltirana, tako da Vam to ne mora biti na brizi, a za navigaciju najbolje koristiti iznad prikazan Google Maps!
            </p>
        </div>
    </div>

</section>

<section class="quote">
    <div class="quote-dio">
        <p class="animate-up">
            Farmica, kao što joj i samo ime govori, mjesto je na kojem žive mnoge životinje, a koji su stalni gosti na Farmici.
            Naši gosti uživaju u prisustvu naših životinja jer su sve miroljubive i željne pažnje. Farmica broji desetak ovaca, mnogo kokoši, patki, guski i naravno mačke i psi! :)
        </p>
    </div>
</section>

<div class="arhiva-slika">
    <img src="/images/macka.jpeg" alt="ljudi">
    <img src="/images/konj.jpeg" alt="ljudi">
    <img src="/images/patke.jpeg" alt="ljudi">
</div>

<section class="quote">
    <div class="quote-dio">
        <p class="animate-up">
           Naše kokoši omogućuju gostima da okuse što su to domaća kokošja jaja i to u sklopu doručka koji je u stalnoj 
           ponudi na Farmici. Doručak je nešto što svi naši gosti hvale i ističu kao nešto posebno, a za sve su to zaslužne 
           domaće namirnice koje su poslužene u sklopu doručka. Osim doručka nudimo i mogućnost večere koja 
           se također sprema s domaćim namirnicama.
        </p>
    </div>
</section>

<div class="arhiva-slika">
    <img src="/images/hrana1.jpeg" alt="ljudi">
    <img src="/images/hrana2.jpeg" alt="ljudi">
    <img src="/images/hrana3.jpeg" alt="ljudi">
</div>


@if (ViewBag.ForReview != null)
{
    var reservation = (Reservation)ViewBag.ForReview;
    <div id="pop" class="modal-pop" data-reservation-id="@reservation.ID">
        <div class="pop-window">
            <h2>Kako Vam se svidjela Farmica? <a class="close-button" onclick="zatvoriModal(@reservation.ID)" href="#">X</a></h2>
            <p>Ocijenite svoj boravak u objektu <span class="bold">@reservation.Accomodation.Name</span>!</p>
            <a class="link-button-action" asp-area="" asp-controller="Review" asp-action="Create" asp-route-reservationID="@reservation.ID">Ocijeni nas!</a>
        </div>
    </div>
}

@section Scripts {
    <script>
        function zatvoriModal(reservationId) {
            document.getElementById('pop').style.display = 'none';
            sessionStorage.setItem('reviewModalDismissed_' + reservationId, 'true');
        }

        document.addEventListener('DOMContentLoaded', function () {
            var modal = document.getElementById('pop');
            if (modal) {
                var reservationId = modal.dataset.reservationId;
                if (sessionStorage.getItem('reviewModalDismissed_' + reservationId)) {
                    modal.style.display = 'none';
                }
            }
        });
    </script>
}