@model Reservation

@{
	ViewData["Title"] = "Dodavanje nove rezervacije";
}

<nav class="breadcrumb">
    <ol class="breadcrumb-dio">
        <li><a asp-action="Index">Popis rezervacija</a></li>
        <li class="active" aria-current="page">Nova rezervacija</li>
    </ol>
</nav>

<section class="contact">
    <div class="contact-dio">
        <div class="contact-form">
            <form asp-controller="Reservation" asp-action="CreateManual" method="post">
			<partial name="_ManualCreateEdit" />
		</form>
        </div>
    </div>
</section>


@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script id="search-js"
            defer
            src="https://api.mapbox.com/search-js/v1.0.0-beta.22/web.js">
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/js/bootstrap-datepicker.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/locales/bootstrap-datepicker.hr.min.js"></script>
    <script>
        $(function () {
            $('.inp-datepicker').datepicker({
                format: $('.inp-datepicker').data('format'),
                autoclose: true,
                todayHighlight: true,
                language: 'hr'
            });
        });
    </script>
}