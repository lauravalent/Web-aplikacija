@model Rad.Model.Review

@{
    ViewData["Title"] = "Uređivanje recenzija";
}


<head>
    <script src="https://unpkg.com/dropzone@5/dist/min/dropzone.min.js"></script>
    <link rel="stylesheet" href="https://unpkg.com/dropzone@5/dist/min/dropzone.min.css" type="text/css" />
</head>
<nav class="breadcrumb">
    <ol class="breadcrumb-dio">
        <li><a asp-action="Index">Popis recenzija</a></li>
        <li class="active" aria-current="page">Uređivanje recenzije</li>
    </ol>
</nav>

<section class="contact">
    <div class="contact-dio">
        <div class="contact-form">
            <form asp-controller="Review" asp-action="Edit">
                <partial name="_CreateEdit" />
            </form>
        </div>
    </div>
</section>